  "author": {
    "name": "Tiger-zero"
  },
  "repository": "https://github.com/Tiger-zero/Cat_two_accessory",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Cat_two 笔记",
        "shortDescription": "查询 Cat_two 笔记，归档 Codex 任务",
        "developerName": "Tiger-zero",
